# Plantilla del .env del SERVIDOR. Cópiala allí como .env y rellénala.
# El .env real nunca se sube al repositorio ni entra en la imagen de Docker.

DJANGO_SETTINGS_MODULE=sistema.settings.prod

# Genera una nueva. La app se niega a arrancar con un marcador de posición:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

DEBUG=False
ALLOWED_HOSTS=jaumeleveling.com,www.jaumeleveling.com

# Dominio y correo para el certificado de Let's Encrypt.
DOMINIO=jaumeleveling.com
ACME_EMAIL=jaumefernandezsunyer12@gmail.com

# Base de datos. La contraseña es obligatoria: el compose de producción falla sin ella.
POSTGRES_DB=sistema
POSTGRES_USER=sistema
POSTGRES_PASSWORD=
DATABASE_URL=postgres://sistema:LA_MISMA_CONTRASENA@db:5432/sistema

TIME_ZONE=Europe/Madrid
LOG_LEVEL=INFO

# IA. Si se deja vacío, el consejo queda apagado y el resto del sistema funciona igual.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
