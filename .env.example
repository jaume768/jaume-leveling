# Copia este archivo a .env y ajusta los valores.

DJANGO_SETTINGS_MODULE=sistema.settings.dev
SECRET_KEY=cambia-esta-clave-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Base de datos (el host "db" es el servicio de docker-compose)
DATABASE_URL=postgres://sistema:sistema@db:5432/sistema
POSTGRES_DB=sistema
POSTGRES_USER=sistema
POSTGRES_PASSWORD=sistema

TIME_ZONE=Europe/Madrid

# SDK de Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
